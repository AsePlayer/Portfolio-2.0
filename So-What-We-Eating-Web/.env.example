# No .env file, API key, billing account, or Worker is needed for normal use.
VITE_DISCOVERY_MODE=live
VITE_RESTAURANT_PROVIDER=openstreetmap
# Optional alternative public/self-hosted open-data endpoints:
# VITE_OVERPASS_URL=https://overpass.private.coffee/api/interpreter
# VITE_PHOTON_URL=https://photon.komoot.io/api/
# Optional Google integration only: explicitly change provider to google-places.
# VITE_RESTAURANT_PROXY_URL=https://your-worker.example/discover
# GOOGLE_MAPS_API_KEY belongs only in that Worker's secrets, never in VITE_*.
# Explicit fictional testing: append ?mode=demo.
