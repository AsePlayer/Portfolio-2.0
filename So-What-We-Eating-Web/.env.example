# Public full HTTPS Worker endpoint (including /discover). Never an API key.
VITE_RESTAURANT_PROXY_URL=
# Production defaults to live even when this endpoint is missing.
VITE_DISCOVERY_MODE=live
# For explicit local testing use ?mode=demo in the URL, or set this mode to demo.
# GOOGLE_MAPS_API_KEY is a Worker secret only. NEVER put it in a VITE_ variable.
