{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "So What We Eating? normalized menu v1",
  "type": "object",
  "required": ["schemaVersion","restaurantId","restaurantName","source","updatedAt","currency","items"],
  "properties": {
    "schemaVersion": {"const":1},
    "restaurantId": {"type":"string","minLength":1,"pattern":"\\S"},
    "restaurantName": {"type":"string","minLength":1,"pattern":"\\S"},
    "source": {"type":"string","minLength":1,"pattern":"\\S"},
    "sourceUrl": {"type":"string","format":"uri","pattern":"^https?://"},
    "updatedAt": {"type":"string","format":"date-time"},
    "currency": {"const":"USD"},
    "items": {
      "type":"array","minItems":1,
      "items": {
        "type":"object","required":["id","name","role","price"],
        "properties": {
          "id":{"type":"string","minLength":1,"pattern":"\\S"},
          "name":{"type":"string","minLength":1,"pattern":"\\S"},
          "description":{"type":"string","minLength":1,"pattern":"\\S"},
          "category":{"type":"string","minLength":1,"pattern":"\\S"},
          "source":{"type":"string","minLength":1,"pattern":"\\S"},
          "role":{"enum":["main","side","appetizer","drink","dessert","combo","shared","other"]},
          "price":{"type":"number","exclusiveMinimum":0,"multipleOf":0.01},
          "serves":{"type":"integer","minimum":1,"maximum":8}
        },
        "if":{"properties":{"role":{"const":"shared"}},"required":["role"]},
        "else":{"properties":{"serves":{"maximum":1}}}
      }
    }
  },
  "$comment":"Runtime validation additionally rejects duplicate item IDs and unsafe integer-cent prices. No sourceUrl is needed for original fixtures."
}
